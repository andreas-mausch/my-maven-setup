<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.neonew</groupId>
  <artifactId>javacard-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/andreas-mausch/my-maven-setup</url>
    <connection>scm:git:git://github.com/andreas-mausch/my-maven-setup.git</connection>
    <developerConnection>scm:git:git@github.com:andreas-mausch/my-maven-setup.git</developerConnection>
  </scm>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/andreas-mausch/my-maven-setup</url>
    </repository>
  </distributionManagement>

  <parent>
    <groupId>de.neonew</groupId>
    <artifactId>java-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>./parent-java.xml</relativePath>
  </parent>

  <properties>
    <version.jcdk>3.0.x</version.jcdk>

    <version.lib.javacard>3.0.5</version.lib.javacard>
    <version.lib.jcardsim>3.0.6.0</version.lib.jcardsim>

    <version.plugin.proguard>2.7.0</version.plugin.proguard>
    <version.plugin.jcdk>0.1.0</version.plugin.jcdk>

    <jcdk.classes.directory>${project.build.directory}/classes</jcdk.classes.directory>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <executions>
            <execution>
              <id>default-compile</id>
              <phase>compile</phase>
              <goals>
                <goal>compile</goal>
              </goals>
              <configuration>
                <fork>true</fork>
                <executable>${java.compiler.main.path}</executable>
                <source>1.2</source>
                <target>1.1</target>
                <compilerArgs>
                  <arg>-bootclasspath</arg>
                  <arg>${javacard.sdk.path}/lib/api_classic.jar</arg>
                  <arg>-Xlint:-options</arg>
                </compilerArgs>
              </configuration>
            </execution>
            <execution>
              <id>default-testCompile</id>
              <phase>test-compile</phase>
              <goals>
                <goal>testCompile</goal>
              </goals>
              <configuration>
                <fork>false</fork>
                <release>${version.java}</release>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${version.plugin.build-helper}</version>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <configuration>
            <includedLicenses combine.children="append">
              <includedLicense>Oracle JavaCard SDK</includedLicense>
            </includedLicenses>
            <overrideUrl>file:///${license-override.path}</overrideUrl>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <executions>
            <execution>
              <id>enforce-applet-id</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireProperty>
                    <property>applet.id</property>
                    <message>You must define &lt;applet.id&gt; in your project POM (e.g.
                      01:02:03:04:05:06)</message>
                  </requireProperty>
                  <requireProperty>
                    <property>main.class</property>
                    <message>You must define &lt;main.class&gt; in your project POM (e.g.
                      com.example.MyApplet). See README.md for details.</message>
                  </requireProperty>
                  <requireProperty>
                    <property>java.compiler.main.path</property>
                    <message>You must specify the JDK 8 javac path via
                      -Djava.compiler.main.path=/path/to/jdk8/bin/javac. See README.md for details.</message>
                  </requireProperty>
                  <requireProperty>
                    <property>javacard.sdk.path</property>
                    <message>You must specify the JavaCard SDK path via
                      -Djavacard.sdk.path=/path/to/javacard/sdk. See README.md for details.</message>
                  </requireProperty>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>com.github.wvengen</groupId>
          <artifactId>proguard-maven-plugin</artifactId>
          <version>${version.plugin.proguard}</version>
          <configuration>
            <injar>classes</injar>
            <outjar>classes-proguard</outjar>
            <options>
              <option>-allowaccessmodification</option>
              <option>-dontwarn java.lang.Class</option>
              <option>-overloadaggressively</option>
              <option>-repackageclasses ''</option>
              <option>-keep public class * extends javacard.framework.Applet { *; }</option>
            </options>
          </configuration>
        </plugin>

        <plugin>
          <!-- https://github.com/code2358/jcdk-maven-plugin -->
          <groupId>com.github.code2358</groupId>
          <artifactId>jcdk-maven-plugin</artifactId>
          <version>${version.plugin.jcdk}</version>
          <configuration>
            <jcdkHome>${javacard.sdk.path}</jcdkHome>
            <jcdkVersion>${version.jcdk}</jcdkVersion>
            <classesDirectory>${jcdk.classes.directory}</classesDirectory>
            <appletClass>${main.class}</appletClass>
            <appletId>${applet.id}</appletId>
            <appletVersion>${applet.version}</appletVersion>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>sanitize-applet-id</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>applet.id.nocolons</name>
              <value>${applet.id}</value>
              <regex>:</regex>
              <replacement></replacement>
            </configuration>
          </execution>
          <execution>
            <id>derive-applet-version</id>
            <phase>initialize</phase>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <configuration>
              <name>applet.version</name>
              <value>${project.version}</value>
              <regex>-.*$</regex>
              <replacement></replacement>
            </configuration>
          </execution>
          <execution>
            <id>attach-cap</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/${applet.id.nocolons}.cap</file>
                  <type>cap</type>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>com.github.code2358</groupId>
        <artifactId>jcdk-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>packageApplet</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>proguard</id>
      <properties>
        <jcdk.classes.directory>${project.build.directory}/classes-proguard</jcdk.classes.directory>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.wvengen</groupId>
            <artifactId>proguard-maven-plugin</artifactId>
            <executions>
              <execution>
                <phase>process-classes</phase>
                <goals>
                  <goal>proguard</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.klinec</groupId>
        <artifactId>jcardsim</artifactId>
        <version>${version.lib.jcardsim}</version>
        <scope>test</scope>
      </dependency>

      <!-- This needs to be down here, because otherwise we get a classpath order conflict with
    jcardsim:
     `Invalid APDU loaded. You may have JC API in your classpath before JCardSim.`

     Requires api_classic.jar installed in your local Maven repository —
     run `mvn install:install-file` once (see README.md). -->
      <dependency>
        <groupId>com.oracle.javacard</groupId>
        <artifactId>api-classic</artifactId>
        <version>${version.lib.javacard}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
