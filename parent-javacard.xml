<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.neonew.build</groupId>
  <artifactId>javacard-parent</artifactId>
  <version>1.6.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>JavaCard Parent</name>
  <description>
    Maven parent POM for JavaCard applets, extending the Java parent with JDK 8 compilation, size optimization, JCDK,
    and jCardSim support.
  </description>
  <url>https://github.com/andreas-mausch/my-maven-setup</url>

  <developers>
    <developer>
      <id>neonew</id>
      <name>neonew</name>
      <email>dev@neonew.de</email>
    </developer>
  </developers>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/andreas-mausch/my-maven-setup</url>
    <connection>scm:git:git://github.com/andreas-mausch/my-maven-setup.git</connection>
    <developerConnection>scm:git:git@github.com:andreas-mausch/my-maven-setup.git</developerConnection>
  </scm>

  <parent>
    <groupId>de.neonew.build</groupId>
    <artifactId>java-parent</artifactId>
    <version>1.6.0-SNAPSHOT</version>
    <relativePath>./parent-java.xml</relativePath>
  </parent>

  <properties>
    <version.jcdk>3.0.x</version.jcdk>

    <version.lib.javacard>3.0.5</version.lib.javacard>
    <version.lib.jcardsim>3.0.6.0</version.lib.jcardsim>

    <version.plugin.jcdk>0.1.0</version.plugin.jcdk>
    <version.plugin.maven-assembly>3.8.0</version.plugin.maven-assembly>

    <jcdk.classes.directory>${project.build.directory}/classes</jcdk.classes.directory>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <executions>
            <execution>
              <id>default-compile</id>
              <phase>compile</phase>
              <goals>
                <goal>compile</goal>
              </goals>
              <configuration>
                <fork>true</fork>
                <executable>${java.compiler.main.path}</executable>
                <source>1.2</source>
                <target>1.1</target>
                <compilerArgs>
                  <arg>-bootclasspath</arg>
                  <arg>${javacard.sdk.path}/lib/api_classic.jar</arg>
                  <arg>-Xlint:-options</arg>
                </compilerArgs>
              </configuration>
            </execution>
            <execution>
              <id>default-testCompile</id>
              <phase>test-compile</phase>
              <goals>
                <goal>testCompile</goal>
              </goals>
              <configuration>
                <fork>false</fork>
                <release>${version.java}</release>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${version.plugin.build-helper}</version>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <configuration>
            <includedLicenses combine.children="append">
              <includedLicense>Oracle JavaCard SDK</includedLicense>
            </includedLicenses>
            <missingLicensesFileArtifact>
              de.neonew.build:maven-build-config:${version.maven-build-config}
            </missingLicensesFileArtifact>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <!-- Lets integration tests read the AIDs without hard-coding them.
              Dotted lowercase names sharing a javacard. prefix to avoid clashes in
              the global system-property namespace. See README-javacard.md, "AIDs". -->
            <systemPropertyVariables>
              <javacard.applet.id>${applet.id}</javacard.applet.id>
              <javacard.applet.id.nocolons>${applet.id.nocolons}</javacard.applet.id.nocolons>
              <javacard.package.id>${package.id}</javacard.package.id>
              <javacard.package.id.nocolons>${package.id.nocolons}</javacard.package.id.nocolons>
            </systemPropertyVariables>
          </configuration>
        </plugin>

        <plugin>
          <groupId>com.github.wvengen</groupId>
          <artifactId>proguard-maven-plugin</artifactId>
          <configuration combine.self="override">
            <skip>true</skip>
            <attach>false</attach>
            <injar>classes</injar>
            <inFilter>${proguard.input.filter}</inFilter>
            <outjar>classes-proguard</outjar>
            <options>
              <option>-allowaccessmodification</option>
              <option>-dontwarn java.lang.Class</option>
              <option>-overloadaggressively</option>
              <option>-repackageclasses ''</option>
              <option>-keep public class * extends javacard.framework.Applet { *; }</option>
            </options>
          </configuration>
          <executions>
            <execution>
              <id>proguard</id>
              <phase>process-classes</phase>
              <goals>
                <goal>proguard</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <!-- https://github.com/code2358/jcdk-maven-plugin -->
          <groupId>com.github.code2358</groupId>
          <artifactId>jcdk-maven-plugin</artifactId>
          <version>${version.plugin.jcdk}</version>
          <configuration>
            <jcdkHome>${javacard.sdk.path}</jcdkHome>
            <jcdkVersion>${version.jcdk}</jcdkVersion>
            <classesDirectory>${jcdk.classes.directory}</classesDirectory>
            <appletClass>${main.class}</appletClass>
            <appletId>${applet.id}</appletId>
            <appletVersion>${applet.version}</appletVersion>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

  </build>

  <profiles>
    <profile>
      <id>javacard-consumer</id>
      <!-- Maven 3.9 exposes packaging for profile activation. This keeps applet-specific plugins active in child
        projects while preventing them from running when the javacard-parent POM itself is built. -->
      <activation>
        <property>
          <name>packaging</name>
          <value>!pom</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>sanitize-applet-id</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>applet.id.nocolons</name>
                  <value>${applet.id}</value>
                  <regex>:</regex>
                  <replacement></replacement>
                </configuration>
              </execution>
              <execution>
                <!-- The JavaCard package AID (identifies the CAP package) is derived from the
                  applet instance AID as its first 5 bytes, mirroring the fixed rule of the
                  jcdk-maven-plugin (see README-javacard.md, section "AIDs"). Do not set
                  package.id manually. -->
                <id>derive-package-id</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>package.id</name>
                  <value>${applet.id}</value>
                  <regex>^([0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){4}).*$</regex>
                  <replacement>$1</replacement>
                </configuration>
              </execution>
              <execution>
                <id>derive-package-id-nocolons</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>package.id.nocolons</name>
                  <value>${package.id}</value>
                  <regex>:</regex>
                  <replacement></replacement>
                </configuration>
              </execution>
              <execution>
                <id>derive-applet-version</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>applet.version</name>
                  <value>${project.version}</value>
                  <regex>-.*$</regex>
                  <replacement></replacement>
                </configuration>
              </execution>
              <execution>
                <id>derive-cap-package-name</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>cap.package.name</name>
                  <value>${main.class}</value>
                  <regex>^(.*)\.[^.]+$</regex>
                  <replacement>$1</replacement>
                </configuration>
              </execution>
              <execution>
                <id>derive-cap-manifest-section</id>
                <phase>initialize</phase>
                <goals>
                  <goal>regex-property</goal>
                </goals>
                <configuration>
                  <name>cap.manifest.section</name>
                  <value>${cap.package.name}</value>
                  <regex>\.</regex>
                  <replacement>/</replacement>
                </configuration>
              </execution>
              <execution>
                <id>register-cap-input</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.build.directory}/cap-work/input.zip</file>
                      <type>cap</type>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
              <execution>
                <id>attach-cap</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.build.directory}/${applet.id.nocolons}.cap</file>
                      <type>cap</type>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <id>clean-cap-intermediates</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${project.build.directory}/cap-work</directory>
                    </fileset>
                    <fileset>
                      <directory>${project.build.directory}/generated-jcdk</directory>
                    </fileset>
                    <fileset>
                      <directory>${project.build.directory}/classes-proguard</directory>
                    </fileset>
                    <fileset>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${applet.id.nocolons}.cap</include>
                        <include>${applet.id.nocolons}.exp</include>
                        <include>${applet.id.nocolons}.jca</include>
                        <include>${applet.id.nocolons}.cap.asc</include>
                      </includes>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-applet-id</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireProperty>
                      <property>applet.id</property>
                      <message>You must define &lt;applet.id&gt; in your project POM: the
                        applet AID, which a default install also uses as the selectable
                        instance AID; 6 to 12 hex bytes separated by colons
                        (e.g. F0:01:02:03:04:01). The JavaCard package AID is automatically
                        derived from its first 5 bytes (exposed as ${package.id}, e.g.
                        F0:01:02:03:04); per JavaCard rules the applet AID must start with the
                        package AID's 5-byte RID. See README-javacard.md, section "AIDs".</message>
                    </requireProperty>
                    <requireProperty>
                      <property>main.class</property>
                      <message>You must define &lt;main.class&gt; in your project POM (e.g.
                        com.example.MyApplet). See README.md for details.</message>
                    </requireProperty>
                    <requireProperty>
                      <property>java.compiler.main.path</property>
                      <message>You must specify the JDK 8 javac path via
                        -Djava.compiler.main.path=/path/to/jdk8/bin/javac. See README.md for details.</message>
                    </requireProperty>
                    <requireProperty>
                      <property>javacard.sdk.path</property>
                      <message>You must specify the JavaCard SDK path via
                        -Djavacard.sdk.path=/path/to/javacard/sdk. See README.md for details.</message>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.code2358</groupId>
            <artifactId>jcdk-maven-plugin</artifactId>
            <executions>
              <execution>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>packageApplet</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-cap</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>${project.groupId}</groupId>
                      <artifactId>${project.artifactId}</artifactId>
                      <version>${project.version}</version>
                      <type>cap</type>
                      <overWrite>true</overWrite>
                      <outputDirectory>${project.build.directory}/cap-work/unpacked</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>${version.plugin.maven-assembly}</version>
            <executions>
              <execution>
                <id>copy-cap-input</id>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <attach>false</attach>
                  <appendAssemblyId>false</appendAssemblyId>
                  <finalName>.</finalName>
                  <outputDirectory>${project.build.directory}/cap-work</outputDirectory>
                  <inlineDescriptors>
                    <inlineDescriptor>
                      <id>cap-input</id>
                      <formats>
                        <format>dir</format>
                      </formats>
                      <includeBaseDirectory>false</includeBaseDirectory>
                      <files>
                        <file>
                          <source>${project.build.directory}/${applet.id.nocolons}.cap</source>
                          <outputDirectory>/</outputDirectory>
                          <destName>input.zip</destName>
                        </file>
                      </files>
                    </inlineDescriptor>
                  </inlineDescriptors>
                </configuration>
              </execution>
              <execution>
                <id>repackage-cap</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <attach>false</attach>
                  <appendAssemblyId>false</appendAssemblyId>
                  <finalName>input</finalName>
                  <outputDirectory>${project.build.directory}/cap-work</outputDirectory>
                  <!-- Merge the fileset manifest first so configured entries override it.
                    manifestFile would instead give the converter's timestamp precedence. -->
                  <mergeManifestMode>merge</mergeManifestMode>
                  <archive>
                    <addMavenDescriptor>false</addMavenDescriptor>
                    <manifest>
                      <addDefaultEntries>false</addDefaultEntries>
                    </manifest>
                    <manifestSections>
                      <manifestSection>
                        <name>${cap.manifest.section}</name>
                        <manifestEntries>
                          <Java-Card-CAP-Creation-Time>${project.build.outputTimestamp}</Java-Card-CAP-Creation-Time>
                        </manifestEntries>
                      </manifestSection>
                    </manifestSections>
                  </archive>
                  <inlineDescriptors>
                    <inlineDescriptor>
                      <id>cap</id>
                      <formats>
                        <format>jar</format>
                      </formats>
                      <includeBaseDirectory>false</includeBaseDirectory>
                      <fileSets>
                        <fileSet>
                          <directory>${project.build.directory}/cap-work/unpacked</directory>
                          <outputDirectory>/</outputDirectory>
                          <useDefaultExcludes>false</useDefaultExcludes>
                        </fileSet>
                      </fileSets>
                    </inlineDescriptor>
                  </inlineDescriptors>
                </configuration>
              </execution>
              <execution>
                <id>copy-normalized-cap</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <attach>false</attach>
                  <appendAssemblyId>false</appendAssemblyId>
                  <finalName>.</finalName>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <inlineDescriptors>
                    <inlineDescriptor>
                      <id>cap-output</id>
                      <formats>
                        <format>dir</format>
                      </formats>
                      <includeBaseDirectory>false</includeBaseDirectory>
                      <files>
                        <file>
                          <source>${project.build.directory}/cap-work/input.jar</source>
                          <outputDirectory>/</outputDirectory>
                          <destName>${applet.id.nocolons}.cap</destName>
                        </file>
                      </files>
                    </inlineDescriptor>
                  </inlineDescriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.wvengen</groupId>
            <artifactId>proguard-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>size-optimization</id>
      <properties>
        <jcdk.classes.directory>${project.build.directory}/classes-proguard</jcdk.classes.directory>
      </properties>
      <build>
        <plugins>
          <!-- JavaCard optimizes classes before conversion; it does not use the JVM shaded-JAR pipeline. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <id>clean-proguard-directories</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>extract-proguard-input</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>package-proguard</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.wvengen</groupId>
            <artifactId>proguard-maven-plugin</artifactId>
            <configuration>
              <skip>false</skip>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.klinec</groupId>
        <artifactId>jcardsim</artifactId>
        <version>${version.lib.jcardsim}</version>
        <scope>test</scope>
      </dependency>

      <!-- This needs to be down here, because otherwise we get a classpath order conflict with
    jcardsim:
     `Invalid APDU loaded. You may have JC API in your classpath before JCardSim.`

     Requires api_classic.jar installed in your local Maven repository —
     run `mvn install:install-file` once (see README.md). -->
      <dependency>
        <groupId>com.oracle.javacard</groupId>
        <artifactId>api-classic</artifactId>
        <version>${version.lib.javacard}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
