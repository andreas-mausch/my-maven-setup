<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.neonew</groupId>
    <artifactId>kotlin-parent</artifactId>
    <version>1.0.0-rc.1</version>
    <relativePath>./parent-kotlin.xml</relativePath>
  </parent>

  <groupId>de.neonew</groupId>
  <artifactId>kotlin-micronaut-parent</artifactId>
  <version>1.0.0-rc.1</version>
  <packaging>pom</packaging>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/andreas-mausch/my-maven-setup</url>
    <connection>scm:git:git://github.com/andreas-mausch/my-maven-setup.git</connection>
    <developerConnection>scm:git:git@github.com:andreas-mausch/my-maven-setup.git</developerConnection>
  </scm>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/andreas-mausch/my-maven-setup</url>
    </repository>
  </distributionManagement>

  <properties>
    <version.micronaut>5.1.5</version.micronaut>
    <version.micronaut.core>5.1.15</version.micronaut.core>
    <version.micronaut.data>5.1.4</version.micronaut.data>
    <version.micronaut.serde>3.1.1</version.micronaut.serde>
    <version.micronaut.aot>3.1.0</version.micronaut.aot>
    <version.micronaut.test-resources>4.1.0</version.micronaut.test-resources>
    <version.lib.awaitility>4.3.0</version.lib.awaitility>
    <version.lib.junit>6.1.3</version.lib.junit>
    <version.lib.kotlin-logging>8.0.4</version.lib.kotlin-logging>
    <version.lib.mongock>5.5.1</version.lib.mongock>
    <version.lib.mongodb-driver>5.9.0</version.lib.mongodb-driver>
    <version.lib.wiremock>3.13.2</version.lib.wiremock>
    <version.plugin.ksp-maven>0.4.7</version.plugin.ksp-maven>
    <version.plugin.micronaut-maven>5.0.2</version.plugin.micronaut-maven>
    <version.maven>3.9.16</version.maven>
    <micronaut.runtime>netty</micronaut.runtime>
    <micronaut.application.package>${project.groupId}</micronaut.application.package>
    <micronaut.aot.enabled>false</micronaut.aot.enabled>
    <micronaut.aot.version>${version.micronaut.aot}</micronaut.aot.version>
    <micronaut.test.resources.enabled>true</micronaut.test.resources.enabled>
    <micronaut.test.resources.version>${version.micronaut.test-resources}</micronaut.test.resources.version>
    <exec.mainClass>${main.class}</exec.mainClass>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.mongodb</groupId>
        <artifactId>mongodb-driver-bom</artifactId>
        <version>${version.lib.mongodb-driver}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.micronaut.platform</groupId>
        <artifactId>micronaut-platform</artifactId>
        <version>${version.micronaut}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.mongock</groupId>
        <artifactId>mongock-bom</artifactId>
        <version>${version.lib.mongock}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.lib.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-reflect</artifactId>
        <version>${version.kotlin}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.platform</groupId>
        <artifactId>junit-platform-commons</artifactId>
        <version>${version.lib.junit}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib-jdk8</artifactId>
        <version>${version.kotlin}</version>
      </dependency>
      <dependency>
        <groupId>io.github.oshai</groupId>
        <artifactId>kotlin-logging-jvm</artifactId>
        <version>${version.lib.kotlin-logging}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility-kotlin</artifactId>
        <version>${version.lib.awaitility}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock</artifactId>
        <version>${version.lib.wiremock}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.micronaut.maven</groupId>
          <artifactId>micronaut-maven-plugin</artifactId>
          <version>${version.plugin.micronaut-maven}</version>
          <extensions>false</extensions>
          <executions>
            <execution>
              <id>start-test-resources</id>
              <phase>pre-integration-test</phase>
              <goals>
                <goal>start-testresources-service</goal>
              </goals>
            </execution>
            <execution>
              <id>stop-test-resources</id>
              <phase>post-integration-test</phase>
              <goals>
                <goal>stop-testresources-service</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>me.kpavlov.ksp.maven</groupId>
          <artifactId>ksp-maven-plugin</artifactId>
          <version>${version.plugin.ksp-maven}</version>
          <configuration>
            <processorOptions>
              <micronaut.processing.group>${project.groupId}</micronaut.processing.group>
              <micronaut.processing.module>${project.artifactId}</micronaut.processing.module>
            </processorOptions>
          </configuration>
          <executions>
            <execution>
              <id>process-main-sources</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>process</goal>
              </goals>
              <configuration>
                <classOutputDir>${project.build.outputDirectory}</classOutputDir>
                <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
              </configuration>
            </execution>
            <execution>
              <id>process-test-sources</id>
              <phase>generate-test-sources</phase>
              <goals>
                <goal>process-test</goal>
              </goals>
              <configuration>
                <classOutputDir>${project.build.testOutputDirectory}</classOutputDir>
                <sourceDirectory>${project.basedir}/src/test/kotlin</sourceDirectory>
                <sourceDirs>
                  <sourceDir>${project.basedir}/src/test-integration/kotlin</sourceDir>
                </sourceDirs>
              </configuration>
            </execution>
          </executions>
          <dependencies>
            <dependency>
              <groupId>io.micronaut</groupId>
              <artifactId>micronaut-inject-kotlin</artifactId>
              <version>${version.micronaut.core}</version>
            </dependency>
            <dependency>
              <groupId>io.micronaut.data</groupId>
              <artifactId>micronaut-data-document-processor</artifactId>
              <version>${version.micronaut.data}</version>
            </dependency>
            <dependency>
              <groupId>io.micronaut.serde</groupId>
              <artifactId>micronaut-serde-processor</artifactId>
              <version>${version.micronaut.serde}</version>
            </dependency>
          </dependencies>
        </plugin>

        <plugin>
          <groupId>org.jetbrains.kotlin</groupId>
          <artifactId>kotlin-maven-plugin</artifactId>
          <configuration combine.self="merge">
            <compilerPlugins>
              <plugin>all-open</plugin>
            </compilerPlugins>
            <pluginOptions>
              <option>all-open:annotation=io.micronaut.aop.Around</option>
            </pluginOptions>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.jetbrains.kotlin</groupId>
              <artifactId>kotlin-maven-allopen</artifactId>
              <version>${version.kotlin}</version>
            </dependency>
          </dependencies>
        </plugin>

        <plugin>
          <groupId>com.github.wvengen</groupId>
          <artifactId>proguard-maven-plugin</artifactId>
          <configuration>
            <libs combine.children="append">
              <lib>${java.home}/jmods/java.compiler.jmod</lib>
              <lib>${java.home}/jmods/java.desktop.jmod</lib>
              <lib>${java.home}/jmods/java.instrument.jmod</lib>
              <lib>${java.home}/jmods/java.logging.jmod</lib>
              <lib>${java.home}/jmods/java.management.jmod</lib>
              <lib>${java.home}/jmods/java.naming.jmod</lib>
              <lib>${java.home}/jmods/java.net.http.jmod</lib>
              <lib>${java.home}/jmods/java.security.jgss.jmod</lib>
              <lib>${java.home}/jmods/java.sql.jmod</lib>
              <lib>${java.home}/jmods/java.xml.jmod</lib>
              <lib>${java.home}/jmods/jdk.jfr.jmod</lib>
              <lib>${java.home}/jmods/jdk.unsupported.jmod</lib>
            </libs>
            <options combine.children="append">
              <option>-keep class ${micronaut.application.package}.** { *; }</option>
              <option>-keep class io.micronaut.** { *; }</option>
              <option>-keep class com.mongodb.** { *; }</option>
              <option>-keep class com.rabbitmq.** { *; }</option>
              <option>-keep class io.netty.** { *; }</option>
              <option>-keep class org.bson.** { *; }</option>
              <option>-keep class reactor.** { *; }</option>
              <option>-keep class tools.jackson.** { *; }</option>
              <option>-keep class com.fasterxml.jackson.** { *; }</option>
              <option>-keep class io.mongock.** { *; }</option>
              <option>-keep class kotlin.** { *; }</option>
              <option>-keep class kotlinx.** { *; }</option>
              <option>-keep class ch.qos.logback.** { *; }</option>
              <option>-keep class org.slf4j.** { *; }</option>
              <option>-keep class org.yaml.snakeyaml.** { *; }</option>
              <option>-dontoptimize</option>
              <option>-dontobfuscate</option>
              <option>-keepdirectories META-INF/micronaut</option>
              <option>-keepdirectories META-INF/micronaut/**</option>
              <option>-adaptresourcefilenames META-INF/micronaut/**</option>
              <option>-adaptresourcefilecontents META-INF/services/**,META-INF/micronaut/**</option>
              <option>-ignorewarnings</option>
              <option>-dontwarn android.**</option>
              <option>-dontwarn io.micrometer.**</option>
              <option>-dontwarn org.bouncycastle.**</option>
              <option>-dontwarn org.conscrypt.**</option>
              <option>-dontwarn org.eclipse.jetty.alpn.**</option>
              <option>-dontwarn org.graalvm.**</option>
              <option>-dontwarn org.jetbrains.annotations.**</option>
              <option>-dontwarn org.openjsse.**</option>
              <option>-dontwarn sun.misc.**</option>
            </options>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
